# Public values safe to expose in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Keep these out of client code.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional observability hooks for later phases.
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Web Push (Modulo F - Central de Notificacoes). Generate with
# `npx web-push generate-vapid-keys`. NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe
# in the browser (it's how the client subscribes); VAPID_PRIVATE_KEY must
# NEVER be prefixed with NEXT_PUBLIC_ and must never reach client code - it
# is only read server-side, inside the push-sending service. Required in
# Development, Preview and Production (same keypair across all three is
# fine and expected - VAPID identifies the *application server*, not the
# environment). CRON_CONTROL_SECRET authenticates calls to
# /api/cron/notifications/process (Vercel Cron sends it automatically once
# configured as this project's cron secret; never expose it to the client).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@projeto30.app
CRON_CONTROL_SECRET=

# Geracao assistida por IA da Biblioteca (Parte C, opcional). Sem estas
# duas variaveis, todo o resto da Biblioteca continua funcionando (CRUD
# manual, revisao, publicacao) - so /admin/biblioteca/gerar fica
# indisponivel e mostra uma mensagem explicando que a IA nao esta
# configurada. Nunca usado no client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
